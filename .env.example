# Appium / ADB
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_DEVICE_NAME=Android
ANDROID_UDID=
ADB_PATH=adb
CONTROL_BACKEND=appium
PAGE_SOURCE_BACKEND=appium
YDL_APP_PACKAGE=com.hzdh.ydl
YDL_APP_ACTIVITY=
APP_STARTUP_SECONDS=8
COMMAND_TIMEOUT_SECONDS=180

# 监控范围
CHECK_INTERVAL_SECONDS=60
SCROLL_ROUNDS=4
POST_MIN_CHARS=18
POST_MAX_CHARS=1200
TOPIC_KEYWORDS=抑郁症,抑郁,情绪低落,不想活,自伤,自杀
TARGET_TAB_TEXTS=心声,问答,树洞,社区,话题
HOME_TAB_TEXTS=首页
HOME_SECTION_TITLE_TEXTS=心声·问答
HOME_SECTION_MORE_TEXTS=更多
SEARCH_TRIGGER_TEXTS=搜索,查找
SEARCH_KEYWORD=

# 发布开关
DRY_RUN=true
ENABLE_AI_REPLY=true
ENABLE_REAL_POST=false
REAL_POST_CONFIRMATION=
ENABLE_FOLLOWUP_REPLY=true
REPLY_MODE=identity_experiment
MAX_POSTS_PER_HOUR=3
MIN_POST_INTERVAL_SECONDS=120
MAX_FOLLOWUPS_PER_THREAD=3
SELF_DISPLAY_NAME=
AI_DISCLOSURE_PREFIX=[AI辅助回复]
AI_DISCLOSURE_SUFFIX=[AI辅助回复]

# 四组实验账号与策略
# account1: 头像使用豆包头像，昵称改为“豆包陪伴AI小助手”；承载策略0和策略1。
# account2: 头像使用豆包头像，昵称使用“豆包”；承载策略2。
# account3: 使用真人头像，昵称不要包含任何AI提示；承载策略3。
EXPERIMENT_ACCOUNT1_NICKNAME=豆包陪伴AI助手
EXPERIMENT_ACCOUNT2_NICKNAME=豆包助手
EXPERIMENT_ACCOUNT3_NICKNAME=暖心同行者
EXPERIMENT_ACTIVE_ACCOUNT_ID=
EXPERIMENT_RANDOM_SEED=ydl_identity_experiment
EXPERIMENT_RESPECT_REPLY_TIMING=true
EXPERIMENT_REPLY_WINDOW_SECONDS=43200
EXPERIMENT_FIRST_REPLY_MIN_SECONDS=0
EXPERIMENT_FIRST_REPLY_MAX_SECONDS=43200

# 评论控件候选文本
COMMENT_ENTRY_TEXTS=评论,写评论,说点什么,我来说两句,回复
COMMENT_INPUT_HINTS=评论,回复,说点什么,输入
SEND_BUTTON_TEXTS=发送,发布,评论,提交

# 数据文件
DATA_DIR=data
POSTS_CSV=data/ydl_posts.csv
REPLIES_CSV=data/ydl_replies.csv
DIALOGUES_CSV=data/ydl_dialogues.csv
RUNS_CSV=data/ydl_runs.csv
DUMPS_DIR=data/dumps

# OpenAI-compatible LLM API
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=180
