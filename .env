# Appium 服务地址，用于 Appium 后端连接手机自动化服务。
APPIUM_SERVER_URL=http://127.0.0.1:4723
# Android 设备名称，Appium capabilities 中的 deviceName。
ANDROID_DEVICE_NAME=Android
# Android 设备 UDID；多设备或无线调试时用于指定目标设备。
ANDROID_UDID=10.162.70.121:36565
# adb 可执行文件路径；CONTROL_BACKEND=adb 或 PAGE_SOURCE_BACKEND=adb 时使用。
ADB_PATH=C:\Users\Redmi\Android\Sdk\platform-tools\adb.exe
# 控制手机的后端，可选 appium 或 adb。
CONTROL_BACKEND=adb
# 获取页面 XML 的后端，可选 appium、adb 或 auto。
PAGE_SOURCE_BACKEND=adb
# 壹点灵 App 包名。
YDL_APP_PACKAGE=com.cxzapp.yidianling
# 壹点灵 App 启动 Activity。
YDL_APP_ACTIVITY=.activity.SplashActivity
# 每次拉起 App 后等待页面稳定的秒数。
APP_STARTUP_SECONDS=8
# Appium 命令超时时间，单位秒。
COMMAND_TIMEOUT_SECONDS=180

# 两次监控轮询之间的间隔，单位秒。
CHECK_INTERVAL_SECONDS=60
# 每个目标页面向下滚动采集的轮数。
SCROLL_ROUNDS=4
# 帖子文本最小长度，短于该值会被过滤。
POST_MIN_CHARS=18
# 帖子文本最大长度，长于该值会被截断。
POST_MAX_CHARS=1200
# 主题关键词，留空表示不过滤关键词。
TOPIC_KEYWORDS=
# 要进入的问答/心声页签文字，多个值用英文逗号分隔。
TARGET_TAB_TEXTS=心声,问答
# 首页底部或顶部入口文字。
HOME_TAB_TEXTS=首页
# 首页中目标板块标题文字。
HOME_SECTION_TITLE_TEXTS=心声·问答
# 首页中目标板块“更多”入口文字。
HOME_SECTION_MORE_TEXTS=更多
# 搜索入口候选文字。
SEARCH_TRIGGER_TEXTS=搜索,查找
# 搜索关键词，留空表示不主动搜索。
SEARCH_KEYWORD=

# 是否干运行；true 时只生成和记录，不真实发布。
DRY_RUN=false
# 是否启用自动生成回复。
ENABLE_AI_REPLY=true
# 是否允许真实点击发布；还需要 DRY_RUN=false 和确认口令。
ENABLE_REAL_POST=true
# 真实发布确认口令，必须为 I_UNDERSTAND_REAL_POSTING 才允许发布。
REAL_POST_CONFIRMATION=I_UNDERSTAND_REAL_POSTING
# 是否监控并回复用户追评；实验模式下会被忽略，以保证每题只进入一个策略组。
ENABLE_FOLLOWUP_REPLY=true
# 回复模式：single_ai=原单条AI回复；identity_experiment=AI身份披露对照实验。
REPLY_MODE=identity_experiment
# 每小时最大发布数，按当前程序进程内最近 3600 秒的真实发送记录统计。
# 例如设为 3 表示任意连续 1 小时内最多真实发布 3 条评论；达到上限后，本轮待发回复会被暂缓/拦截。
# 这个限制是全局限频，不区分策略0/1/2/3，也不按帖子单独计算；DRY_RUN=true 的干运行不会计入。
MAX_POSTS_PER_HOUR=3
# 两次真实发布之间的最小间隔，单位秒。
MIN_POST_INTERVAL_SECONDS=120
# 同一帖子最多自动回复多少条追评。
MAX_FOLLOWUPS_PER_THREAD=5
# 当前登录账号昵称，用于识别并忽略自己的已发评论。
SELF_DISPLAY_NAME=豆包助手
# 原单条 AI 模式使用的 AI 披露前缀。
AI_DISCLOSURE_PREFIX=[AI辅助回复]
# 实验策略0使用的结尾 AI 披露标签。
AI_DISCLOSURE_SUFFIX=[AI辅助回复]

# 实验账户1昵称：用于策略0和策略1，明确包含 AI 身份。
EXPERIMENT_ACCOUNT1_NICKNAME=豆包陪伴AI小助手
# 实验账户2昵称：用于策略2，弱化为助手身份。
EXPERIMENT_ACCOUNT2_NICKNAME=豆包
# 实验账户3昵称：用于策略3真人风格对照。
EXPERIMENT_ACCOUNT3_NICKNAME=暖心同行者
# 当前手机实际登录的实验账号 ID；真实发布时必须设置为 account1、account2 或 account3。
EXPERIMENT_ACTIVE_ACCOUNT_ID=account1
# 实验随机种子；相同帖子和 question_id 会得到稳定的随机顺序与时间。
EXPERIMENT_RANDOM_SEED=ydl_identity_experiment
# 是否尊重随机计划时间；false 时生成后立即进入待发布。
EXPERIMENT_RESPECT_REPLY_TIMING=true
# 实验回复必须落入的问题发现后时间窗口，单位秒；43200=12小时。
EXPERIMENT_REPLY_WINDOW_SECONDS=43200
# 第一条回复最早延迟，单位秒；3600=1小时。
EXPERIMENT_FIRST_REPLY_MIN_SECONDS=0
# 第一条回复最晚延迟，单位秒；43200=12小时。
EXPERIMENT_FIRST_REPLY_MAX_SECONDS=43200
# 第二条回复相对第一条回复的最小间隔，单位秒；600=10分钟。
# 兼容旧配置：当前四组实验每题只发一条回复，以下 second gap 参数已不再使用。
EXPERIMENT_SECOND_REPLY_GAP_MIN_SECONDS=600
# 第二条回复相对第一条回复的最大间隔，单位秒；21600=6小时。
EXPERIMENT_SECOND_REPLY_GAP_MAX_SECONDS=21600

# 评论入口候选文字；校准后可按 App 实际 XML 调整。
COMMENT_ENTRY_TEXTS=用文字鼓舞人心,评论,写评论,说点什么,我来说两句,回复
# 评论输入框 hint 或相关文字候选。
COMMENT_INPUT_HINTS=评论,回复,说点什么,输入,用文字鼓舞人心
# 发送按钮候选文字。
SEND_BUTTON_TEXTS=发表,发送,发布,评论,提交

# 数据目录。
DATA_DIR=data
# 采集到的帖子 CSV 路径。
POSTS_CSV=data/ydl_posts.csv
# 生成、排程和发布结果 CSV 路径。
REPLIES_CSV=data/ydl_replies.csv
# 对话事件 CSV 路径。
DIALOGUES_CSV=data/ydl_dialogues.csv
# 每轮运行统计 CSV 路径。
RUNS_CSV=data/ydl_runs.csv
# 页面 XML 和截图 dump 保存目录。
DUMPS_DIR=data/dumps

# OpenAI-compatible LLM API 地址。
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM API Key。
LLM_API_KEY=sk-f1e502f50d60434385b102a0f10906d9
# LLM 模型名称。
LLM_MODEL=qwen3.5-plus-2026-04-20
# LLM 请求超时时间，单位秒。
LLM_TIMEOUT_SECONDS=60
# LLM 采样温度，越低越稳定。
LLM_TEMPERATURE=0.4
# LLM 单次回复最大 token 数。
LLM_MAX_TOKENS=180
